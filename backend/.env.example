PORT=5050
DATABASE_URL="postgresql://username:password@localhost:5432/ncc_command_db?schema=public"
NODE_ENV=development
JWT_SECRET="your_jwt_super_secure_secret_key"

# AI Integrations (Command Saathi)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# ============================================================
# ATTENDANCE SMS & WHATSAPP NOTIFICATION PROVIDERS
# ============================================================

# Notification Mode: TEST (routes all messages to test number) or PRODUCTION
ATTENDANCE_NOTIF_MODE=TEST

# FAST2SMS (India Free SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# TWILIO (Global SMS fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# MSG91 (WhatsApp Business API)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WHATSAPP_SRC=91XXXXXXXXXX
MSG91_WHATSAPP_TEMPLATE_ID=ncc_attendance_notification

# ============================================================
# OFFICIAL EMAIL RECOVERY (GMAIL SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kashmirgaming033@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=kashmirgaming033@gmail.com
SMTP_FROM_NAME=Army Institute of Technology NCC
