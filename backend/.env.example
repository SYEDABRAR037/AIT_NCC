PORT=5050
# Runtime database connection (Supavisor session mode port 5432 or direct port 5432)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
# Direct migration connection (required for Prisma migrate when DATABASE_URL is pooled)
# In single-URL environments (e.g. Render fallback or local dev), DIRECT_URL defaults to DATABASE_URL.
DIRECT_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
NODE_ENV=development
# Comma-separated allowed browser origins. Remove localhost entries in production.
CORS_ORIGIN=http://localhost:3000,https://<your-site>.netlify.app
# Replace with a unique random secret before starting; SET_ME is intentionally rejected.
JWT_SECRET=SET_ME
# Dedicated secret for signing OTP HMAC-SHA256 challenges (minimum 32 characters).
# Replace with a unique random secret before starting; SET_ME is intentionally rejected.
OTP_SECRET=SET_ME
# Optional shared transition cutoff timestamp for rolling deployment legacy OTP compatibility (ISO 8601).
# If configured, unexpired legacy challenges created before this cutoff can verify using JWT_SECRET during rollout overlap.
# After this cutoff, all challenges strictly require OTP_SECRET with zero fallback.
# OTP_TRANSITION_CUTOFF=2026-11-07T22:30:00.000Z

# AI Integrations (Command Saathi)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# ============================================================
# ATTENDANCE SMS & WHATSAPP NOTIFICATION PROVIDERS
# ============================================================
# Registration and login SMS OTPs use Fast2SMS first, then Twilio if Fast2SMS
# is missing or rejects the message. Configure one complete provider set.

# Notification Mode: TEST (routes all messages to test number) or PRODUCTION
ATTENDANCE_NOTIF_MODE=TEST

# FAST2SMS (India Free SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# TWILIO (Global SMS fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# MSG91 (WhatsApp Business API)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WHATSAPP_SRC=91XXXXXXXXXX
MSG91_WHATSAPP_TEMPLATE_ID=ncc_attendance_notification

# ============================================================
# EMAIL OTP DELIVERY (Brevo HTTPS API preferred; all values backend-only)
# ============================================================
# Create an API key in Brevo and verify/activate this sender before use.
# When BREVO_API_KEY is set, OTPs use Brevo HTTPS API and do not fall back on failure.
BREVO_API_KEY=SET_IN_RENDER_SECRET_MANAGER
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Army Institute of Technology NCC
# Legacy alternatives (optional; do not assume SMTP works on Render Free).
EMAIL_RELAY_URL=https://<your-site>.netlify.app/.netlify/functions/email-relay
RECOVERY_RELAY_SECRET=SET_ME_TO_THE_SAME_RANDOM_SECRET_ON_BACKEND_AND_NETLIFY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_verified_sender_email
SMTP_FROM_NAME=Army Institute of Technology NCC

# Optional web-push notifications (backend only)
VAPID_PUBLIC_KEY=generate_a_vapid_key_pair
VAPID_PRIVATE_KEY=keep_this_secret_server_side
VAPID_SUBJECT=mailto:ncc@aitpune.edu.in
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=64_hex_characters_from_a_cryptographically_secure_random_key
PUBLIC_APP_URL=https://<your-site>.netlify.app
