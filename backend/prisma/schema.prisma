generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "app_private"]
}

enum Role {
  ADMIN_ANO
  DRILL_INSTRUCTOR
  PLATOON_SENIOR
  SENIOR
  CADET
  @@schema("public")
}

enum AccountStatus {
  UNDER_REVIEW
  ANO_REVIEW
  APPROVED
  ACTIVE
  HOLD
  RETURNED
  REJECTED
  INACTIVE
  PASSED_OUT
  @@schema("public")
}

model User {
  id                 String        @id @default(uuid())
  fullName           String
  regimentalNumber   String        @unique
  collegeRollNumber  String        @unique
  email              String        @unique
  phone              String?
  year               String
  branch             String
  platoonName        String        @default("Alpha")
  battalion          String        @default("2 Maharashtra Battalion NCC, Pune")
  company            String        @default("Bravo Company")
  group              String        @default("Pune Group HQ")
  team               String?
  enrollmentDetails  String?
  dateOfJoining      DateTime      @default(now())
  profilePhotoUrl    String?
  passwordHash       String
  role               Role          @default(CADET)
  status             AccountStatus @default(UNDER_REVIEW)
  emailVerified      Boolean       @default(false)
  mobileVerified     Boolean       @default(false)
  rank               String        @default("CDT")
  digitalIdToken     String?       @unique @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Assignment relations
  cadetsMentored     SeniorAssignment[] @relation("SeniorMentor")
  mentorAssignment   SeniorAssignment?  @relation("AssignedCadet")
  platoonAssignments PlatoonSeniorAssignment[]
  reviewsConducted   ReviewRecord[]     @relation("Reviewer")
  applicationReviews ReviewRecord[]     @relation("CadetReviews")
  leaves             Leave[]
  leaveReviews       LeaveReviewRecord[]  @relation("LeaveReviewer")
  cadetRequests      Request[]            @relation("CadetRequests")
  officerRequestActions RequestHistoryRecord[] @relation("OfficerRequestActions")
  timelineEvents     TimelineEvent[]      @relation("CadetTimeline")
  assignedDuties     Duty[]               @relation("AssignedDuties")
  officerAssignedDuties Duty[]            @relation("OfficerAssignedDuties")
  campParticipations CampParticipant[]
  eventParticipations EventParticipant[]
  trainingAttendances TrainingAttendance[]
  cadetInspections    TurnoutInspection[]  @relation("CadetInspections")
  conductedInspections TurnoutInspection[] @relation("InspectorRecords")
  certificates        Certificate[]        @relation("CadetCertificates")
  biometricTemplate   BiometricTemplate?
  challengeSubjects   BiometricVerificationChallenge[] @relation("ChallengeSubject")
  biometricChallengeQuota BiometricChallengeSubjectQuota? @relation("ChallengeQuotaSubject")
  attendanceNotifications AttendanceNotification[]
  inquiryReplies      InquiryReply[]       @relation("UserInquiryReplies")
  passwordResets      PasswordReset[]
  otpChallenges       OtpChallenge[]
  rankHistory         RankHistory[] @relation("CadetRankHistory")
  rankChanges         RankHistory[] @relation("RankChangedBy")
  notifications       Notification[]
  notificationPreferences NotificationPreferences?
  pushSubscriptions   WebPushSubscription[]
  notificationReads  NotificationRead[]
  authSessions       AuthSession[]
  drillInstructorAssignments DrillInstructorAssignment[]
  recoveryChallenges RecoveryChallenge[]
  performanceAssessmentsGiven PerformanceAssessment[] @relation("PerformanceEvaluator")
  performanceAssessmentsReceived PerformanceAssessment[] @relation("PerformanceCadet")
  performanceSnapshots PerformanceScoreSnapshot[]

  @@index([role])
  @@index([status])
  @@schema("public")
}


model ReviewRecord {
  id         String   @id @default(uuid())
  cadetId    String
  reviewerId String
  stage      String   // SENIOR_REVIEW | PLATOON_SENIOR_REVIEW | ANO_FINAL_APPROVAL
  action     String   // FORWARD | APPROVE | REJECT | HOLD | CORRECTION_REQUESTED
  remarks    String?
  createdAt  DateTime @default(now())

  cadet    User @relation("CadetReviews", fields: [cadetId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([cadetId])
  @@index([reviewerId])
  @@schema("public")
}

model GalleryPhoto {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("NCC")
  altText     String
  image       Bytes
  mimeType    String
  isPublished Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@schema("public")
}

model RankHolder {
  id        String   @id @default(uuid())
  rank      String   @unique
  name      String?
  image     Bytes?
  mimeType  String?
  isActive  Boolean  @default(false)
  sortOrder Int
  updatedAt DateTime @updatedAt
  @@schema("public")
}

model InstitutionalInfo {
  id          String   @id @default("main")
  address     String?
  email       String?
  phone       String?
  timings     String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  @@schema("public")
}

model SeniorAssignment {
  id         String   @id @default(uuid())
  seniorId   String
  cadetId    String   @unique
  assignedAt DateTime @default(now())

  senior     User     @relation("SeniorMentor", fields: [seniorId], references: [id], onDelete: Cascade)
  cadet      User     @relation("AssignedCadet", fields: [cadetId], references: [id], onDelete: Cascade)

  @@index([seniorId])
  @@schema("public")
}

model PlatoonSeniorAssignment {
  id              String   @id @default(uuid())
  platoonSeniorId String
  platoonId       String
  assignedAt      DateTime @default(now())

  platoonSenior   User     @relation(fields: [platoonSeniorId], references: [id], onDelete: Cascade)
  platoon         Platoon  @relation(fields: [platoonId], references: [id], onDelete: Cascade)

  @@unique([platoonSeniorId, platoonId])
  @@schema("public")
}

model DrillInstructorAssignment {
  id                    String   @id @default(uuid())
  drillInstructorId     String
  platoonId             String
  assignedAt            DateTime @default(now())

  drillInstructor User    @relation(fields: [drillInstructorId], references: [id], onDelete: Cascade)
  platoon         Platoon @relation(fields: [platoonId], references: [id], onDelete: Cascade)

  @@unique([drillInstructorId, platoonId])
  @@index([platoonId])
  @@schema("public")
}

model Platoon {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  platoonSeniors PlatoonSeniorAssignment[]
  drillInstructors DrillInstructorAssignment[]
  @@schema("public")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  biometricChallenges BiometricVerificationChallenge[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@unique([id, userId], map: "AuthSession_id_userId_key")
  @@schema("public")
}

model RecoveryChallenge {
  id             String    @id @default(uuid())
  userId         String?
  lookupHash     String
  otpHash        String
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  sendCount      Int       @default(1)
  lastSentAt     DateTime  @default(now())
  deliveryStatus String    @default("QUEUED")
  verifiedAt     DateTime?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([lookupHash, createdAt])
  @@index([expiresAt])
  @@schema("public")
}

model PerformanceAssessment {
  id             String   @id @default(uuid())
  cadetId        String
  evaluatorId    String
  category       String   // DRILL | FITNESS | TRAINING | CAMP_EVENT | CERT_ACHIEVEMENT | DISCIPLINE_LEADERSHIP
  score          Float
  title          String
  feedback       String?
  assessmentDate DateTime @default(now())
  createdAt      DateTime @default(now())
  cadet          User     @relation("PerformanceCadet", fields: [cadetId], references: [id], onDelete: Cascade)
  evaluator      User     @relation("PerformanceEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  @@index([cadetId, category, assessmentDate])
  @@index([evaluatorId])
  @@schema("public")
}

model PerformanceScoreSnapshot {
  id             String   @id @default(uuid())
  cadetId        String
  period         String   // MONTHLY | QUARTERLY | ANNUAL | SERVICE
  periodStart    DateTime
  periodEnd      DateTime
  overallScore   Float?
  grade          String?
  completeness   Float
  categories     Json
  sourceDigest   String
  calculatedAt   DateTime @default(now())
  cadet          User     @relation(fields: [cadetId], references: [id], onDelete: Cascade)
  @@unique([cadetId, period, periodStart, sourceDigest])
  @@index([cadetId, periodStart])
  @@schema("public")
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   @default("General")
  isPublic    Boolean  @default(true)
  isUrgent    Boolean  @default(false)
  targetRole  Role?
  targetPlatoon String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@schema("public")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String
  eventType     String   @default("OTHER") // PARADE | TRAINING | CAMP | ACTIVITY | COMPETITION | MEETING | DUTY | IMPORTANT_DATE | OTHER
  eventDate     DateTime
  startTime     String?
  endTime       String?
  location      String
  isPublic      Boolean  @default(true)
  status        String   @default("PUBLISHED") // PUBLISHED | CANCELLED
  referenceType String?  // CAMP | TRAINING_SESSION | DUTY
  referenceId   String?  // ID of linked Camp, Session, or Duty
  organizer     String?  @default("AIT NCC Command")
  createdAt     DateTime @default(now())

  participants EventParticipant[]
  @@schema("public")
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  cadetId   String
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cadet User  @relation(fields: [cadetId], references: [id], onDelete: Cascade)

  @@unique([eventId, cadetId])
  @@schema("public")
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  dateAwarded DateTime
  cadetName   String?
  isPublic    Boolean  @default(true)
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@schema("public")
}

model Camp {
  id                String   @id @default(uuid())
  name              String
  campType          String
  location          String
  startDate         DateTime
  endDate           DateTime
  description       String?
  capacity          Int      @default(50)
  reportingTime     String?  @default("06:00 hrs")
  eligibility       String?  @default("Open to all active cadets with >= 75% attendance")
  instructions      String?
  requiredDocuments String?  @default("Medical Certificate, Indemnity Bond, College ID")
  assignedOfficers  String?
  status            String   @default("OPEN")
  reportingVenue    String?
  eligibleYears     String?
  targetPlatoon     String?
  targetTeam        String?
  createdAt         DateTime @default(now())

  participants CampParticipant[]
  documents    CampDocument[]
  @@schema("public")
}

model CampDocument {
  id        String   @id @default(uuid())
  campId    String
  title     String
  url       String
  createdAt DateTime @default(now())
  camp      Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@index([campId])
  @@schema("public")
}

model CampParticipant {
  id        String   @id @default(uuid())
  campId    String
  cadetId   String
  status    String   @default("APPLIED") // APPLIED | RECOMMENDED | SELECTED | CONFIRMED | PARTICIPATED | COMPLETED | REJECTED
  remarks   String?
  createdAt DateTime @default(now())

  camp  Camp @relation(fields: [campId], references: [id], onDelete: Cascade)
  cadet User @relation(fields: [cadetId], references: [id], onDelete: Cascade)

  @@unique([campId, cadetId])
  @@schema("public")
}

model Leave {
  id              String   @id @default(uuid())
  cadetId         String
  leaveType       String   // Medical | Academic | Personal | Emergency
  startDate       DateTime
  endDate         DateTime
  reason          String
  remarks         String?
  documentUrl     String?
  status          String   @default("SUBMITTED") // SUBMITTED | SENIOR_REVIEW | PLATOON_SENIOR_REVIEW | ANO_REVIEW | APPROVED | REJECTED | RETURNED | CANCELLED
  finalDecisionBy String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cadet        User                @relation(fields: [cadetId], references: [id], onDelete: Cascade)
  leaveReviews LeaveReviewRecord[]

  @@index([cadetId])
  @@index([status])
  @@schema("public")
}

model LeaveReviewRecord {
  id           String   @id @default(uuid())
  leaveId      String
  reviewerId   String
  reviewerRole Role
  stage        String   // SENIOR_REVIEW | PLATOON_SENIOR_REVIEW | ANO_FINAL_REVIEW
  action       String   // FORWARD | APPROVE | REJECT | RETURN | CANCEL
  remarks      String?
  createdAt    DateTime @default(now())

  leave    Leave @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  reviewer User  @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([leaveId])
  @@index([reviewerId])
  @@schema("public")
}

model Request {
  id                  String   @id @default(uuid())
  requestNumber       String   @unique
  requestType         String   // LEAVE | PROFILE_CORRECTION | CERTIFICATE_VERIFICATION | CAMP_PARTICIPATION | DUTY_RELATED | DOCUMENT_REQUEST | OTHER
  cadetId             String
  title               String
  description         String
  priority            String   @default("NORMAL") // NORMAL | HIGH | URGENT
  status              String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | FORWARDED | APPROVED | REJECTED | RETURNED | CANCELLED
  currentReviewerRole Role?
  currentReviewerId   String?
  supportingDocUrl    String?
  metadata            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cadet   User                   @relation("CadetRequests", fields: [cadetId], references: [id], onDelete: Cascade)
  history RequestHistoryRecord[]
  replies InquiryReply[]

  @@index([cadetId])
  @@index([status])
  @@index([requestType])
  @@schema("public")
}

model RequestHistoryRecord {
  id             String   @id @default(uuid())
  requestId      String
  officerId      String
  officerRole    Role
  action         String   // SUBMIT | FORWARD | APPROVE | REJECT | RETURN | CANCEL
  remarks        String?
  previousStatus String
  newStatus      String
  createdAt      DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  officer User    @relation("OfficerRequestActions", fields: [officerId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([officerId])
  @@schema("public")
}

model InquiryReply {
  id         String   @id @default(uuid())
  requestId  String
  senderId   String
  senderName String
  senderRole Role
  message    String
  createdAt  DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User    @relation("UserInquiryReplies", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([senderId])
  @@index([createdAt])
  @@schema("public")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  cadetId     String
  category    String   // REGISTRATION | APPROVAL | ATTENDANCE | LEAVE | CAMP | ACTIVITY | DUTY | CERTIFICATE | ACHIEVEMENT | REQUEST | PROFILE_UPDATE
  title       String
  description String
  actorId     String?
  actorRole   Role?
  metadata    String?
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  cadet User @relation("CadetTimeline", fields: [cadetId], references: [id], onDelete: Cascade)

  @@index([cadetId])
  @@index([category])
  @@index([eventDate])
  @@schema("public")
}

model Duty {
  id              String   @id @default(uuid())
  title           String
  dutyType        String   // Guard of Honour | Quarter Guard | Pilot Escort | Parade Commander | Flag Officer | Armoury Duty | Administrative
  location        String
  dutyDate        DateTime
  startTime       String?
  endTime         String?
  reportingTime   String   @default("06:00 hrs")
  instructions    String?
  assignedCadetId String
  assignedById    String
  status          String   @default("ASSIGNED") // ASSIGNED | COMPLETED | EXCUSED
  createdAt       DateTime @default(now())

  cadet      User @relation("AssignedDuties", fields: [assignedCadetId], references: [id], onDelete: Cascade)
  assignedBy User @relation("OfficerAssignedDuties", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([assignedCadetId])
  @@index([dutyDate])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@schema("public")
}

model RankHistory {
  id               String   @id @default(uuid())
  cadetId          String
  previousRank     String
  newRank          String
  appointmentDate  DateTime
  remarks          String?
  changedById      String
  changedAt        DateTime @default(now())

  cadet     User @relation("CadetRankHistory", fields: [cadetId], references: [id], onDelete: Cascade)
  changedBy User @relation("RankChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([cadetId, changedAt])
  @@index([changedById])
  @@schema("public")
}

model Notification {
  id                    String   @id @default(uuid())
  userId                String?
  targetRole            Role?
  title                 String
  message               String
  type                  String   @default("SYSTEM")
  priority              String   @default("NORMAL")
  referenceType         String?
  referenceId           String?
  eventKey              String?  @unique
  isRead                Boolean  @default(false)
  isUrgent              Boolean  @default(false)
  emailStatus           String   @default("PENDING")
  pushStatus            String   @default("PENDING")
  emailAttempts         Int      @default(0)
  pushAttempts          Int      @default(0)
  nextDeliveryAt        DateTime @default(now())
  processingLeaseAt     DateTime?
  deliveryLastError     String?
  securityMandatory     Boolean  @default(false)
  fanoutAt              DateTime?
  createdAt             DateTime @default(now())
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads                 NotificationRead[]

  @@index([userId, createdAt])
  @@index([emailStatus, pushStatus, nextDeliveryAt])
  @@index([targetRole, createdAt])
  @@schema("public")
}

model NotificationPreferences {
  id           String   @id @default(uuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("public")
}

model WebPushSubscription {
  id                    String   @id @default(uuid())
  userId                String
  endpointHash          String   @unique
  encryptedSubscription String
  createdAt             DateTime @default(now())
  lastUsedAt            DateTime?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@schema("public")
}

model TrainingSession {
  id            String   @id @default(uuid())
  title         String
  activity      String
  timing        String
  startTime     String   @default("06:00")
  endTime       String?
  location      String
  focus         String
  conductedBy   String
  creatorRole   String   @default("PLATOON_SENIOR")
  targetPlatoon String?
  status        String   @default("ACTIVE") // ACTIVE | CLOSED
  expectedCount Int      @default(0)
  presentCount  Int      @default(0)
  absentCount   Int      @default(0)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  attendanceWindowStartAt DateTime? @db.Timestamptz(6) @map("attendance_window_start_at")
  attendanceWindowEndAt   DateTime? @db.Timestamptz(6) @map("attendance_window_end_at")
  attendanceWindowTimeZoneId String? @db.VarChar(64) @map("attendance_window_time_zone_id")

  attendance  TrainingAttendance[]
  inspections TurnoutInspection[]
  attendanceNotifications AttendanceNotification[]
  biometricChallenges BiometricVerificationChallenge[]
  @@schema("public")
}

model TrainingAttendance {
  id                 String   @id @default(uuid())
  sessionId          String
  cadetId            String
  status             String   @default("PRESENT") // PRESENT | ABSENT | EXCUSED
  verificationMethod String   @default("LIVE_FACE_VERIFIED") // LIVE_FACE_VERIFIED | MANUAL_OVERRIDE | APPROVED_LEAVE
  verificationStatus String   @default("VERIFIED") // VERIFIED | FAILED
  confidenceScore    Float?
  verifiedBy         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cadet   User            @relation(fields: [cadetId], references: [id], onDelete: Cascade)

  @@unique([sessionId, cadetId])
  @@schema("public")
}

model BiometricTemplate {
  id            String   @id @default(uuid())
  cadetId       String   @unique
  descriptor    String   // JSON serialized array of 128 float values
  photoSnapshot String?  // Optional base64 or URL thumbnail
  qualityScore  Float    @default(0.95)
  registeredBy  String   @default("SYSTEM")
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cadet User @relation(fields: [cadetId], references: [id], onDelete: Cascade)

  @@index([cadetId])
  @@schema("public")
}

model TurnoutInspection {
  id                    String   @id @default(uuid())
  sessionId             String?
  cadetId               String
  inspectorId           String
  drillGrade            String   @default("A") // A | B | C | D (Needs Improvement)
  uniformScore          Int      @default(9)  // 1 to 10
  shaveBeretHackleScore Int      @default(9)  // 1 to 10
  bootsPolishScore      Int      @default(9)  // 1 to 10
  remarks               String?
  createdAt             DateTime @default(now())

  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cadet     User             @relation("CadetInspections", fields: [cadetId], references: [id], onDelete: Cascade)
  inspector User             @relation("InspectorRecords", fields: [inspectorId], references: [id], onDelete: Cascade)

  @@index([cadetId])
  @@index([inspectorId])
  @@schema("public")
}

model Certificate {
  id               String   @id @default(uuid())
  certificateNo    String   @unique
  verificationHash String   @unique
  cadetId          String
  certificateType  String   // 'A' Certificate | 'B' Certificate | 'C' Certificate | 'ATC Camp Certificate' | 'Special Commendation'
  title            String
  grade            String   @default("A") // A | B | C
  issuingUnit      String   @default("2 Maharashtra Battalion NCC, Pune")
  institution      String   @default("Army Institute of Technology, Pune")
  issuedBy         String   @default("Lt. Col. R.K. Sharma, ANO")
  issueDate        DateTime @default(now())
  status           String   @default("VALID") // VALID | REVOKED | SUSPENDED
  campName         String?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cadet            User     @relation("CadetCertificates", fields: [cadetId], references: [id], onDelete: Cascade)

  @@index([cadetId])
  @@index([certificateNo])
  @@index([certificateType])
  @@schema("public")
}

model AttendanceNotification {
  id                 String    @id @default(uuid())
  attendanceId       String?
  sessionId          String
  cadetId            String
  eventType          String    // 'ATTENDANCE_MARKED_PRESENT' | 'ATTENDANCE_MARKED_ABSENT'
  channel            String    // 'SMS' | 'WHATSAPP'
  recipientPhone     String
  messageContent     String
  templateId         String?
  status             String    @default("QUEUED") // 'QUEUED' | 'SENT' | 'DELIVERED' | 'FAILED'
  providerMessageId  String?
  failureReason      String?
  retryCount         Int       @default(0)
  idempotencyKey     String    @unique
  queuedAt           DateTime  @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cadet   User            @relation(fields: [cadetId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([cadetId])
  @@index([status])
  @@index([eventType])
  @@schema("public")
}

model PasswordReset {
  id           String    @id @default(uuid())
  userId       String
  otpHash      String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  lastResendAt DateTime  @default(now())
  verifiedAt   DateTime?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("public")
}

enum OtpPurpose {
  REGISTRATION_EMAIL
  REGISTRATION_MOBILE
  LOGIN
  @@schema("public")
}

enum BiometricChallengePurpose {
  ATTENDANCE_1_TO_1

  @@map("biometric_challenge_purpose")
  @@schema("app_private")
}

enum BiometricChallengeIntegrityState {
  BLOCKED
  READY

  @@map("biometric_challenge_integrity_state")
  @@schema("app_private")
}

enum BiometricChallengeIntegrityActorKind {
  SYSTEM
  SERVICE
  DATABASE_OPERATOR

  @@map("biometric_challenge_integrity_actor_kind")
  @@schema("app_private")
}

// Operational policy is intentionally represented by rows, not schema defaults.
// If the active policy or singleton quota row is absent/invalid, challenge
// issue, consume, and cleanup routines must fail closed. Do not seed policy
// values until separately approved. Partial indexes and cross-table checks are
// reserved for reviewed custom migration SQL (P0.3).
model BiometricChallengePolicy {
  policyVersion            String   @id @map("policy_version")
  policyHash               String   @unique(map: "biometric_challenge_policy_policy_hash_key") @db.Char(64) @map("policy_hash")
  maxChallengeTtlMs        BigInt   @map("max_challenge_ttl_ms")
  globalOutstandingLimit   Int      @map("global_outstanding_limit")
  subjectOutstandingLimit  Int      @map("subject_outstanding_limit")
  retainedLimit            Int      @map("retained_limit")
  globalTokenCapacity      Decimal  @db.Decimal(18, 6) @map("global_token_capacity")
  globalRefillPerSecond    Decimal  @db.Decimal(18, 6) @map("global_refill_per_second")
  subjectTokenCapacity     Decimal  @db.Decimal(18, 6) @map("subject_token_capacity")
  subjectRefillPerSecond   Decimal  @db.Decimal(18, 6) @map("subject_refill_per_second")
  consumedRetentionMs      BigInt   @map("consumed_retention_ms")
  expiredRetentionMs       BigInt   @map("expired_retention_ms")
  cleanupBatchLimit        Int      @map("cleanup_batch_limit")
  cleanupSubjectLimit      Int      @map("cleanup_subject_limit")
  createdAt                DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) @map("created_at")

  globalQuotas BiometricChallengeGlobalQuota[]
  challenges   BiometricVerificationChallenge[]
  integrityGate   BiometricChallengeIntegrityGate[]
  integrityEvents BiometricChallengeIntegrityEvent[]

  @@map("biometric_challenge_policy")
  @@schema("app_private")
}

model BiometricChallengeGlobalQuota {
  singletonKey          String   @id @map("singleton_key")
  activePolicyVersion   String   @map("active_policy_version")
  globalOutstanding     Int      @default(0) @map("global_outstanding")
  retainedCount         Int      @default(0) @map("retained_count")
  globalTokenBalance    Decimal  @db.Decimal(18, 6) @map("global_token_balance")
  globalRefilledAt      DateTime @db.Timestamptz(6) @map("global_refilled_at")
  updatedAt             DateTime @db.Timestamptz(6) @map("updated_at")

  activePolicy BiometricChallengePolicy @relation(fields: [activePolicyVersion], references: [policyVersion], onDelete: Restrict)

  @@map("biometric_challenge_global_quota")
  @@schema("app_private")
}

model BiometricChallengeSubjectQuota {
  subjectUserId String   @id @map("subject_user_id")
  outstanding   Int      @default(0)
  tokenBalance  Decimal  @db.Decimal(18, 6) @map("token_balance")
  refilledAt    DateTime @db.Timestamptz(6) @map("refilled_at")
  updatedAt     DateTime @db.Timestamptz(6) @map("updated_at")

  subjectUser User @relation("ChallengeQuotaSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@map("biometric_challenge_subject_quota")
  @@schema("app_private")
}

model BiometricVerificationChallenge {
  id                String                    @id
  tokenHash         String                    @unique(map: "biometric_challenge_token_hash_key") @db.VarChar(64) @map("token_hash")
  subjectUserId     String                    @map("subject_user_id")
  trainingSessionId String                    @map("training_session_id")
  authSessionId     String                    @map("auth_session_id")
  policyVersion     String                    @map("policy_version")
  purpose           BiometricChallengePurpose
  createdAt         DateTime                  @db.Timestamptz(3) @map("created_at")
  expiresAt         DateTime                  @db.Timestamptz(3) @map("expires_at")
  consumedAt        DateTime?                 @db.Timestamptz(3) @map("consumed_at")

  subjectUser    User                     @relation("ChallengeSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  trainingSession TrainingSession          @relation(fields: [trainingSessionId], references: [id], onDelete: Restrict)
  authSession    AuthSession              @relation(fields: [authSessionId, subjectUserId], references: [id, userId], onDelete: Restrict, map: "biometric_challenge_auth_owner_fk")
  policy         BiometricChallengePolicy @relation(fields: [policyVersion], references: [policyVersion], onDelete: Restrict)

  @@index([expiresAt, id], map: "biometric_challenge_cleanup_expiry_idx")
  @@index([authSessionId, id], map: "biometric_challenge_auth_session_idx")
  @@index([trainingSessionId, id], map: "biometric_challenge_training_session_idx")
  @@map("biometric_verification_challenge")
  @@schema("app_private")
}

// This row has no Prisma state default: only a reviewed database routine may
// transition it. Missing rows or non-READY states must deny biometric writes.
// The migration seeds BLOCKED/NOT_CONFIGURED; this is not an operational policy.
model BiometricChallengeIntegrityGate {
  singletonKey   String                               @id @map("singleton_key")
  state          BiometricChallengeIntegrityState
  reasonCode     String                               @map("reason_code")
  policyVersion  String?                              @map("policy_version")
  stateRevision  BigInt                               @default(1) @map("state_revision")
  changedAt      DateTime                             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) @map("changed_at")
  actorKind      BiometricChallengeIntegrityActorKind @map("actor_kind")
  actorPrincipal String                               @map("actor_principal")
  actorUserId    String?                              @map("actor_user_id")
  auditReference String?                              @map("audit_reference")

  policy BiometricChallengePolicy?       @relation(fields: [policyVersion], references: [policyVersion], onDelete: Restrict)
  events BiometricChallengeIntegrityEvent[]

  @@map("biometric_challenge_integrity_gate")
  @@schema("app_private")
}

model BiometricChallengeIntegrityEvent {
  id             BigInt                               @id @default(autoincrement())
  singletonKey   String                               @map("singleton_key")
  stateRevision  BigInt                               @map("state_revision")
  previousState  BiometricChallengeIntegrityState?    @map("previous_state")
  newState       BiometricChallengeIntegrityState     @map("new_state")
  reasonCode     String                               @map("reason_code")
  policyVersion  String?                              @map("policy_version")
  actorKind      BiometricChallengeIntegrityActorKind @map("actor_kind")
  actorPrincipal String                               @map("actor_principal")
  actorUserId    String?                              @map("actor_user_id")
  auditReference String?                              @map("audit_reference")
  occurredAt     DateTime                             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) @map("occurred_at")

  gate   BiometricChallengeIntegrityGate @relation(fields: [singletonKey], references: [singletonKey], onDelete: Restrict)
  policy BiometricChallengePolicy?       @relation(fields: [policyVersion], references: [policyVersion], onDelete: Restrict)

  @@unique([singletonKey, stateRevision], map: "biometric_challenge_integrity_event_revision_key")
  @@index([occurredAt, id], map: "biometric_challenge_integrity_event_time_idx")
  @@map("biometric_challenge_integrity_event")
  @@schema("app_private")
}

model OtpChallenge {
  id             String     @id @default(uuid())
  purpose        OtpPurpose
  userId         String?
  destination    String
  otpHash        String?
  expiresAt      DateTime
  verifiedAt     DateTime?
  proofExpiresAt DateTime?
  consumedAt     DateTime?
  attemptCount   Int        @default(0)
  sendCount      Int        @default(1)
  rememberMe     Boolean    @default(false)
  lastSentAt     DateTime   @default(now())
  createdAt      DateTime   @default(now())
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, destination, createdAt])
  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@schema("public")
}
