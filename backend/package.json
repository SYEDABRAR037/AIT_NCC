{
  "name": "ncc-backend",
  "version": "1.0.0",
  "description": "Backend service for NCC Digital Command System",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/start.js",
    "dev": "ts-node-dev --respawn --transpile-only src/start.ts",
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node src/../prisma/seed.ts",
    "test": "NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/test-isolation-regression.test.ts && NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/script-database-safety.test.ts && NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/public-routes.test.ts && NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/biometric-security.test.ts",
    "test:biometric": "NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/biometric-security.test.ts",
    "test:isolation": "NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/test-isolation-regression.test.ts",
    "test:public": "NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/public-routes.test.ts",
    "test:runtime-config": "NODE_ENV=test PURE_MOCK_TEST=true ts-node src/__tests__/runtime-config.test.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "twilio": "^6.1.1",
    "typescript": "^5.7.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/web-push": "^3.6.4"
  }
}
