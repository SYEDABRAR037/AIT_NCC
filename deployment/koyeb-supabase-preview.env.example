# Preview/staging template only. Do not use for production or real NCC records.
# Configure these placeholders in the isolated preview service's secret manager.
NODE_ENV=production
PORT=<Koyeb-provided-port>
DATABASE_URL=<isolated-Supabase-preview-PostgreSQL-URL-with-TLS>
JWT_SECRET=<unique-random-preview-secret-at-least-32-characters>
CORS_ORIGIN=<approved-preview-website-origin>
PUBLIC_APP_URL=<approved-preview-website-origin>
ENABLE_BIOMETRIC_ATTENDANCE=false

# Configure only if a controlled test mailbox and relay have been approved.
# Do not set real email, SMS, push, or production relay credentials here.
# RECOVERY_API_BASE_URL=<preview-backend-HTTPS-origin>
